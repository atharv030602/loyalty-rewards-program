<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent POM for the whole platform.
      Inheriting from spring-boot-starter-parent gives every module the same,
      tested set of dependency versions (Spring, Kafka client, Jackson, JUnit...),
      so child modules never write a version number for those libraries.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.loyalty</groupId>
    <artifactId>loyalty-rewards-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- "pom" packaging = this project produces no jar; it only groups the modules below. -->
    <packaging>pom</packaging>
    <name>Loyalty Rewards Platform</name>
    <description>Mini loyalty and rewards system built as two event-driven microservices</description>

    <modules>
        <module>order-service</module>
        <module>rewards-service</module>
        <!-- Must stay last: it tests the two runnable jars built by the modules above. -->
        <module>e2e-tests</module>
    </modules>

    <properties>
        <!-- Compile for Java 17 even if a newer JDK is installed (uses javac's release flag). -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc is not part of Spring Boot, so its version is written once, here. -->
        <springdoc.version>2.8.13</springdoc.version>
    </properties>

    <!-- dependencyManagement only FIXES versions; a module still has to ask for the dependency. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
